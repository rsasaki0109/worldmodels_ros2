<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>world_model_dwb_critics</name>
  <version>0.7.1</version>
  <description>
    DWB TrajectoryCritic plugin that scores trajectories against a World Model's
    predicted FutureOccupancy (same lethal-union rule as world_model_costmap).
  </description>
  <maintainer email="rsasaki0109@gmail.com">Ryohei Sasaki</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>dwb_core</depend>
  <depend>dwb_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>pluginlib</depend>
  <depend>world_model_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <dwb_core plugin="${prefix}/world_model_dwb_critics_plugins.xml" />
  </export>
</package>
