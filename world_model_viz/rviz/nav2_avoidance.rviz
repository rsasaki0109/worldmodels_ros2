Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 10
      Reference Frame: map
    - Class: rviz_default_plugins/MarkerArray
      Name: PredictedLethal
      Enabled: true
      Topic:
        Value: /costmap_preview/predicted_lethal
    - Class: rviz_default_plugins/MarkerArray
      Name: AvoidancePaths
      Enabled: true
      Topic:
        Value: /avoidance_demo/avoidance_paths
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 90
      X: 1.6
      Y: 1.6
Window Geometry:
  Height: 800
  Width: 1200
