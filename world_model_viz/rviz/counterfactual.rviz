Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: map
    - Class: rviz_default_plugins/MarkerArray
      Name: CounterfactualPanels
      Enabled: true
      Topic:
        Value: /counterfactual_viz/counterfactual/markers
    - Class: rviz_default_plugins/MarkerArray
      Name: Imagination
      Enabled: true
      Topic:
        Value: /world_model_viz/imagination
    - Class: rviz_default_plugins/Image
      Name: CounterfactualMosaic
      Enabled: true
      Topic:
        Value: /counterfactual_viz/counterfactual/mosaic
      Normalize Range: true
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200
